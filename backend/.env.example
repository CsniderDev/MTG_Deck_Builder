# Copy this file to backend/.env and fill in real values. Never commit backend/.env.

# --- LLM provider ---------------------------------------------------------------
# Which LLM generates decks: "gemini" (default, has a free tier) or "openai"
# (ChatGPT models; pay-as-you-go API billing, separate from a ChatGPT Plus plan).
# Only the selected provider's key is needed.
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 0 = no "thinking" pass (~3x faster builds). -1 = model default. Some newer
# models can't turn thinking off; use -1 if the model rejects 0.
GEMINI_THINKING_BUDGET=0

OPENAI_API_KEY=
# Any chat model that supports JSON mode; check platform.openai.com/docs/models.
OPENAI_MODEL=gpt-4.1-mini

# --- CORS -----------------------------------------------------------------------
# Comma-separated list of allowed frontend origins, e.g.
# FRONTEND_ORIGIN=https://your-deployed-frontend.example.com,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# --- Abuse / cost protection ----------------------------------------------------
# Requests per IP allowed per day on /api/decks/build and /api/decks/revamp.
DAILY_IP_LIMIT=50
# Hard ceiling on real LLM API calls per UTC day, shared across all users.
LLM_DAILY_CALL_LIMIT=300
# Consecutive LLM failures before the circuit breaker opens.
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=60
# How long identical build/revamp responses are cached before a repeat request
# is allowed to hit the LLM/Scryfall/EDHREC again.
RESPONSE_CACHE_TTL_SECONDS=120

# Cloudflare Turnstile secret key (server-side). Leave empty to disable bot
# verification. Get one at https://dash.cloudflare.com/ -> Turnstile.
TURNSTILE_SECRET_KEY=

# Shared access code for a friends-only deployment. When set, the site asks for
# it once (stored in the browser) and build/revamp requests must include it.
ACCESS_CODE=

# Set to true ONLY when this app is deployed behind a trusted reverse proxy/CDN
# (Cloudflare, nginx, etc) that overwrites X-Forwarded-For itself. Leaving this
# false when directly internet-facing is important: X-Forwarded-For is a
# client-supplied header, and trusting it without a proxy in front lets anyone
# spoof their rate-limit identity and bypass the per-IP limits above.
TRUST_X_FORWARDED_FOR=false

# Optional Slack-style incoming webhook URL, notified when the daily LLM
# call budget crosses 80% and 100% usage. Leave empty to disable.
ALERT_WEBHOOK_URL=
