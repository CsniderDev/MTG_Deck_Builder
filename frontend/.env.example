# Copy this file to frontend/.env.local and fill in real values (Vite loads
# .env.local automatically and it's gitignored by default patterns).

# Cloudflare Turnstile SITE key (public, safe to expose in the built frontend).
# Leave empty to disable the bot-verification widget on the build/revamp forms.
# Get one at https://dash.cloudflare.com/ -> Turnstile. Must match the
# TURNSTILE_SECRET_KEY configured on the backend.
VITE_TURNSTILE_SITE_KEY=

# Public URL of the FastAPI backend, e.g. https://mtg-deck-builder-api.onrender.com
# Leave empty for local dev (Vite proxies /api to http://localhost:8000).
# For the GitHub Pages build, set this as a repository *variable* named
# VITE_API_BASE_URL (Settings -> Secrets and variables -> Actions -> Variables).
VITE_API_BASE_URL=
